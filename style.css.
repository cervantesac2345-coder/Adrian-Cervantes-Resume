* {

  box-sizing: border-box;

}

body {

  margin: 0;

  font-family: Arial, sans-serif;

  background: #f4f6f8;

  color: #222;

}

header {

  background: #172554;

  color: white;

  padding: 24px;

}

nav {

  display: flex;

  gap: 20px;

}

nav a {

  color: white;

  text-decoration: none;

}

nav a:hover {

  text-decoration: underline;

}

main {

  max-width: 900px;

  margin: 40px auto;

  padding: 24px;

}

button {

  padding: 12px 18px;

  border: none;

  border-radius: 8px;

  background: #2563eb;

  color: white;

  cursor: pointer;

}

button:hover {

  opacity: 0.85;

}
